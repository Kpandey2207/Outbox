# --- Core ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Public origin the browser uses for /auth and /integrations callbacks. With the Next.js
# rewrites in front, this is the frontend origin.
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgres://outbox:outbox@localhost:5432/outbox
REDIS_URL=redis://localhost:6379
# Secrets live only in this file (never committed) or your host's secret settings.
# Generate with: openssl rand -hex 32   (production refuses the placeholder and anything under 32 chars)
JWT_SECRET=change-me-to-a-long-random-string
# Encrypts Slack tokens and SMTP passwords in Postgres. 32 bytes as hex or base64
# (openssl rand -hex 32). If unset it is derived from JWT_SECRET.
DATA_ENCRYPTION_KEY=
# Defaults to true when NODE_ENV=production. Set false only for plain-http local setups.
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
# Who may open Bull Board (/admin/queues): emails, comma separated, or * for every signed-in
# user (a local demo only). Unset: everyone on a localhost dev setup, nobody otherwise.
# The Docker stack runs in production mode, so set this to use the queue dashboard there.
QUEUE_ADMIN_EMAILS=
# How many proxies in front of the API may set X-Forwarded-For (used for per-IP limits).
# Leave empty locally and in Docker. On a host behind a load balancer (Render, Railway) use
# the number of proxy hops, usually 1, plus 1 more when the frontend's rewrites sit in front.
# Never "true": that lets any client choose its IP.
TRUST_PROXY=
# Per-IP and per-user request limits on sign in and write endpoints.
RATE_LIMIT_ENABLED=true

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) -------
# Authorized redirect URI: ${API_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local shortcut that signs in a demo user without Google. Refused when NODE_ENV=production
# or when FRONTEND_URL is not a localhost address (anyone reaching it becomes the demo user).
DEV_LOGIN_ENABLED=false

# --- Slack OAuth (https://api.slack.com/apps) -------------------------------
# Scopes: chat:write, incoming-webhook. Redirect URL: ${API_URL}/integrations/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# --- Elasticsearch (optional; search falls back to Postgres when unset or down)
ELASTICSEARCH_URL=http://localhost:9200
# For secured clusters (Elastic Cloud); credentials in the URL also work.
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=emails

# --- SMTP / Ethereal ----------------------------------------------------------
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
# Leave empty to create a fresh Ethereal inbox per sender automatically.
ETHEREAL_USER=
ETHEREAL_PASS=

# --- Queue, rate limiting, throttling -----------------------------------------
QUEUE_NAME=email-send
WORKER_CONCURRENCY=5
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=30000
MIN_DELAY_BETWEEN_SENDS_MS=1000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_EMAILS_PER_HOUR_GLOBAL=1000
SEND_LEASE_MS=120000

# --- Attachments (every email in a campaign carries the files) -------------------
MAX_ATTACHMENT_BYTES=10485760
MAX_ATTACHMENTS_PER_EMAIL=5
MAX_ATTACHMENTS_TOTAL_BYTES=20971520
# Uploaded files not yet scheduled, per user.
MAX_PENDING_UPLOADS=20

# --- Campaign size ------------------------------------------------------------------
MAX_RECIPIENTS_PER_CAMPAIGN=10000
# Emails waiting to be sent per user, across all campaigns.
MAX_SCHEDULED_PER_USER=50000
# Body bytes x recipients per campaign (each email stores its own copy of the body).
MAX_CAMPAIGN_BYTES=52428800

# Run the email worker inside the API process (single-instance free hosting such as Render).
RUN_WORKER_IN_API=false
